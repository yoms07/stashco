# Server Configuration
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/stellar_ambassador?schema=public"

# Session signing (wallet auth) — 32+ random bytes
SESSION_SECRET=your-super-secret-key-change-in-production-must-be-32-chars-min

# Stellar / Soroban
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Deployed contract id (C...) — set after `make deploy`
AMBASSADOR_CONTRACT_ID=

# Server keypair (secret seed, S...) for calls the backend submits on users' behalf.
# Needs XLM for fees. Testnet only; leave unset to disable those endpoints.
SERVER_SIGNER_SECRET=
