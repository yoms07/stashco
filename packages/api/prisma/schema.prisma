generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Single-use login challenge. The wallet is the identity — there is no user table.
model Nonce {
  id        String    @id @default(cuid())
  wallet    String
  nonce     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([wallet, usedAt])
  @@map("nonces")
}
