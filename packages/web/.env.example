# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001

# Stellar / Soroban
# Network: testnet | mainnet | futurenet | local
NEXT_PUBLIC_STELLAR_NETWORK=testnet
# Deployed contract id (C...) — set after `make deploy`
NEXT_PUBLIC_TREASURY_CONTRACT_ID=
# Principal deposited, in raw 7-decimal contract units (e.g. 4000000000 = 400 USDC). The
# contract has no cumulative-deposit storage key (docs/CONTRACT_SPEC.md) — this is a stopgap
# until it does. Leave unset to hide the principal reference line in the position chart.
NEXT_PUBLIC_TREASURY_PRINCIPAL_UNITS=
# Optional endpoint overrides (defaults come from @stashco/shared per network)
# NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
